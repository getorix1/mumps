# Dec 14, 2025 

echo
echo "*************************************************************"
echo "Now install @mumps_version@-amd64.deb"
echo
echo "You may need to remove an old version. If so, use:"
echo
echo "  sudo dpkg --remove mumps-sqlite3"
echo "or"
echo "  sudo dpkg --remove mumps-native-single-user"
echo
echo "You should probably update your system cache before the above"
echo "due to the possibility of system support libraries being installed:"
echo
echo  "  sudo apt update"
echo
echo "Next install the package:"
echo
echo "  sudo dpkg --install @mumps_version@-amd64.deb"
echo
echo "Post-install, use:  "
echo
echo "  sudo apt install -f  "
echo
echo "to fix any missing packages detected by dpkg."
echo "*************************************************************"
echo
echo
